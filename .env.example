# Copy to .env.local for local development. Never commit real secrets.
# Values are created in Supabase Project Settings → API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# These are browser-safe only when Supabase RLS and Storage policies are configured correctly.
# NEVER add SUPABASE_SERVICE_ROLE_KEY or any privileged secret to a VITE_* variable.
